# JARVIS AI Backend Configuration
# Copy to .env and customize

# Server
JARVIS_HOST=127.0.0.1
JARVIS_PORT=9000
JARVIS_DEBUG=true
JARVIS_LOG_LEVEL=DEBUG

# Database
JARVIS_DB_URL=sqlite+aiosqlite:///./data/jarvis.db

# Ollama
JARVIS_OLLAMA_HOST=http://localhost:11434
JARVIS_OLLAMA_MODEL=qwen2.5:3b
JARVIS_OLLAMA_MODELS_PATH=F:/models

# Security
JARVIS_SECRET_KEY=change-me-in-production
JARVIS_BCRYPT_ROUNDS=12
JARVIS_AUTH_LOCKOUT_SECONDS=60
JARVIS_AUTH_MAX_ATTEMPTS=3
JARVIS_SESSION_TIMEOUT_MINUTES=30

# CORS
JARVIS_CORS_ORIGINS=["http://localhost:3000","http://localhost:9000"]

# Agent Protocol
JARVIS_AGENT_BASE_PORT=9100
JARVIS_AGENT_TIMEOUT_SECONDS=30
JARVIS_AGENT_MAX_CONCURRENT=5

# Screenshots
JARVIS_SCREENSHOT_QUALITY=80
JARVIS_SCREENSHOT_RETENTION_DAYS=30

# WebSocket
JARVIS_WS_HEARTBEAT_SECONDS=30
JARVIS_WS_IDLE_TIMEOUT_SECONDS=300
